# Zyntiqo — Environment Variables
# Copy this file to .env and fill in the values when integrations are added.
# Never commit real secrets to source control.

# Supabase (backend / lead storage / SaaS platform database)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# WhatsApp (click-to-chat CTAs)
# International format, no "+" or spaces (e.g. 919876543210)
VITE_WHATSAPP_NUMBER=

# AI Assistant (content generation, lead qualification, recommendations, chatbot)
# Set to true when AI edge function + API key are deployed
VITE_AI_ENABLED=false
# Deployed as an edge function secret (never in frontend code):
# AI_API_KEY=

# AI Image Generation (visual concepts for campaigns, branding, marketing)
# Set to true when image generation edge function + API key are deployed
VITE_IMAGE_GEN_ENABLED=false
# Deployed as an edge function secret (never in frontend code):
# IMAGE_GEN_API_KEY=

# Social Media Links (only set URLs that actually exist)
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_YOUTUBE=
VITE_SOCIAL_X=

# Email Notifications (Resend)
# Set to true when Resend edge function + API key are deployed
VITE_EMAIL_ENABLED=false
# Deployed as edge function secrets (never in frontend code):
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# Calendar Integration (Google, Microsoft, Calendly, Cal.com)
# Set to true when calendar edge function + credentials are deployed
VITE_CALENDAR_ENABLED=false
# Options: google | microsoft | calendly | calcom | none
VITE_CALENDAR_PROVIDER=none
# Deployed as edge function secrets (never in frontend code):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=

# CRM (future lead pipeline)
CRM_API_KEY=
CRM_WEBHOOK_URL=

# Payments (future)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=
